# PRZYKŁADOWY plik sekretów. NIE wpisuj tu prawdziwych wartości.
# Ten plik służy wyłącznie jako szablon pokazujący strukturę.
#
# W produkcji (Streamlit Community Cloud) sekrety ustawiasz w panelu aplikacji
# w zakładce "Settings" -> "Secrets". Skopiuj poniższe wartości i podmień
# znaki zastępcze na prawdziwe.
#
# UWAGA: Plik secrets.toml (bez sufiksu .example) jest w .gitignore i
# nie powinien nigdy trafić do publicznego repozytorium.

# Hasło wspólne dla zespołu (operatorzy mediaroom)
app_password = "TUTAJ_USTAW_HASLO"

# Klucz API do Anthropic (zaczyna się od sk-ant-...)
anthropic_api_key = "sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
